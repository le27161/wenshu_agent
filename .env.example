# LLM provider
LLM_API_KEY=your_dashscope_api_key_here
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# MySQL (Docker publishes container port 3306 as host port 13308)
MYSQL_HOST=localhost
MYSQL_PORT=13308
MYSQL_USER=appuser
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_META_DATABASE=meta
MYSQL_DW_DATABASE=dw
MYSQL_OLIST_DATABASE=olist
OLIST_DATA_DIR=./data/olist

# Local infrastructure
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=data_agent

# Docker host ports and frontend API proxy
MYSQL_HOST_PORT=13308
ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
EMBEDDING_HOST_PORT=8081
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
